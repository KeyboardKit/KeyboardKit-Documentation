{"metadata":{"title":"Dictation","images":[{"type":"card","identifier":"Feature-Dictation.jpg"}],"modules":[{"name":"KeyboardKit"}],"role":"article","color":{"standardColorIdentifier":"purple"},"roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"KeyboardKit makes it easy to perform dictation directly from the keyboard extension, after starting dictation from the main app. See the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Dictation-Article"},{"text":" article for more information about this feature.","type":"text"}]},{"style":"important","type":"aside","content":[{"inlineContent":[{"text":"👑 Dictation requires a KeyboardKit Pro license with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/ProFeature\/dictation","type":"reference"},{"text":" support, unless you want to implement the feature from scratch. You can sign up for KeyboardKit Pro from the ","type":"text"},{"type":"reference","identifier":"https:\/\/keyboardkit.com","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Important"},{"type":"heading","text":"How to perform dictation","anchor":"How-to-perform-dictation","level":2},{"type":"paragraph","inlineContent":[{"text":"A keyboard extension must open the main app to start dictation. After this, dictation is performed in either the keyboard or main app, as defined by the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationSettings\/dictationMethod"},{"text":" in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationSettings"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationMethod\/app","type":"reference"},{"text":" - Dictation is performed in the app, then navigates back to the keyboard to apply the result.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationMethod\/keyboard","isActive":true},{"type":"text","text":" - Dictation is started in the app, then navigates back to the keyboard to perform dictation within the extension."}],"type":"paragraph"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationMethod\/app","isActive":true},{"type":"text","text":" method is soft deprecated and will be removed in KeyboardKit 11. Make sure to transition to use the "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationMethod\/keyboard","isActive":true},{"type":"text","text":" method before upgrading to 11.0."}],"type":"paragraph"}],"type":"aside","name":"Important","style":"important"},{"inlineContent":[{"type":"text","text":"After setting up dictation as described below, you can start dictation by triggering the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAction\/dictation"},{"type":"text","text":" action in your keyboard extension."}],"type":"paragraph"},{"level":2,"text":"How to set up dictation","type":"heading","anchor":"How-to-set-up-dictation"},{"inlineContent":[{"text":"Setting up dictation involves adding the required permissions to the main app, setting up ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Data-Syncing","isActive":true},{"type":"text","text":" between the main app and its keyboard, and setting up a speech recognizer. The steps below will guide you through this process."}],"type":"paragraph"},{"level":3,"text":"Step 1. Required permissions","anchor":"Step-1-Required-permissions","type":"heading"},{"inlineContent":[{"type":"text","text":"Before you can start dictation, you must add these required keys to your app’s "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":", otherwise your app will crash at runtime:"}],"type":"paragraph"},{"syntax":null,"code":["<key>NSMicrophoneUsageDescription<\/key>","<string>Describe why you need microphone access.<\/string>","<key>NSSpeechRecognitionUsageDescription<\/key>","<string>Describe why you need speech recognition.<\/string>"],"type":"codeListing"},{"inlineContent":[{"text":"If you use the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationMethod\/keyboard"},{"text":" dictation method, you must also add background audio permissions to keep dictation alive in the background:","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["<key>UIBackgroundModes<\/key>","<array>","    <string>audio<\/string>","<\/array>"],"type":"codeListing"},{"inlineContent":[{"type":"image","identifier":"developer-dictation-background-modes"}],"type":"paragraph"},{"inlineContent":[{"text":"If you don’t add this to the ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":", dictation will stop detecting speech and volume as soon as the app returns to the keyboard.","type":"text"}],"type":"paragraph"},{"name":"Important","content":[{"inlineContent":[{"type":"text","text":"If you don’t use the audio background mode for anything else in your app, you should explain why you need it in AppStore Connect, to avoid that Apple rejects your app. Here’s a template that you can use."}],"type":"paragraph"}],"style":"important","type":"aside"},{"syntax":null,"code":["Regarding Audio Background Mode","    ","The keyboard extension in this app has a dictation feature that relies on continuous","dictation updates from the app. When a user starts dictation, the keyboard will open","the app to start dictation, then read dictation updates that are provided by the app","while the app is in the background. The user can stop dictation at any time.","","Since the app will be in the background, it needs the Audio Background Mode to avoid","that the dictation is cancelled. The mode is only used to maintain the audio capture","and speech recognition pipeline required for dictation to work.","","If you need to locate this feature:","","    1.    Enable the keyboard in Settings.","    2.    Use the keyboard from any text field.","    3.    Start dictation with the keyboard dictation button.","    4.    Continue dictating while the app is not in the foreground.","","Just let us know if you need any further clarification or information regarding this."],"type":"codeListing"},{"level":3,"text":"Step 2. Set up an App Group","anchor":"Step-2-Set-up-an-App-Group","type":"heading"},{"inlineContent":[{"text":"To share data between your app and keyboard, you must setup an App Group for both targets, as described in the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Data-Syncing"},{"text":" article.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Step 3. Set up a URL Scheme","anchor":"Step-3-Set-up-a-URL-Scheme","type":"heading"},{"inlineContent":[{"text":"To make it possible for the keyboard to open the app and start dictation, you must set up a deep link URL scheme to open the main app:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"developer-dictation-url-scheme"}],"type":"paragraph"},{"inlineContent":[{"text":"The URL scheme must be unique for your app, for instance ","type":"text"},{"code":"myapp:\/\/","type":"codeVoice"},{"text":". Add this to your ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp"},{"text":"’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/deepLinks-swift.property"},{"text":"  ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/DeepLinks-swift.struct\/app"},{"text":" property:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["KeyboardApp(..., deepLinks: .init(app: \"myapp:\/\/\"))"],"type":"codeListing"},{"inlineContent":[{"text":"KeyboardKit will use ","type":"text"},{"code":"<SCHEME>dictation","type":"codeVoice"},{"text":" as the default dictation deep link, but you can customize this if it conflicts with your app.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Step 4. Create a Speech Recognizer","anchor":"Step-4-Create-a-Speech-Recognizer","type":"heading"},{"inlineContent":[{"text":"KeyboardKit uses a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationSpeechRecognizer"},{"text":" protocol to decouple KeyboardKit from the Speech framework, to avoid having to add dictation permissions in apps that don’t use dictation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Instead, you can copy this standard speech recognizer and add it to your app, then inject it with ","type":"text"},{"code":".standard","type":"codeVoice"},{"text":" when setting up dictation:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import KeyboardKit","import Speech","","public extension DictationSpeechRecognizer where Self == StandardSpeechRecognizer {","","    static var standard: Self { .init() }","} ","","public class StandardSpeechRecognizer: DictationSpeechRecognizer {","","    public init() {}","","    private var recognizer: SFSpeechRecognizer?","    private var request: SFSpeechAudioBufferRecognitionRequest?","    private var speechRecognizerTask: SFSpeechRecognitionTask?","","    private typealias Err = Dictation.ServiceError","","    public var authorizationStatus: Dictation.AuthorizationStatus {","        SFSpeechRecognizer.authorizationStatus().keyboardDictationStatus","    }","","    public var supportedLocales: [Locale] {","        Array(SFSpeechRecognizer.supportedLocales())","    }","","    public func requestDictationAuthorization() async throws -> Dictation.AuthorizationStatus {","        await withCheckedContinuation { continuation in","            SFSpeechRecognizer.requestAuthorization { status in","                continuation.resume(returning: status.keyboardDictationStatus)","            }","        }","    }","","    public func resetDictationResult() async throws {}","","    public func startDictation(","        with locale: Locale","    ) async throws {","        try await startDictation(","            with: locale,","            resultHandler: nil","        )","    }","","    public func startDictation(","        with locale: Locale,","        resultHandler: ((Dictation.SpeechRecognizerResult) -> Void)?","    ) async throws {","        recognizer = SFSpeechRecognizer(locale: locale)","        guard let recognizer else { throw Err.missingSpeechRecognizer }","        request = SFSpeechAudioBufferRecognitionRequest()","        request?.shouldReportPartialResults = true","        guard let request else { throw Err.missingSpeechRecognitionRequest }","        speechRecognizerTask = recognizer.recognitionTask(with: request) {","            let result = Dictation.SpeechRecognizerResult(","                dictatedText: $0?.bestTranscription.formattedString,","                error: $1,","                isFinal: $0?.isFinal ?? true)","            resultHandler?(result)","        }","    }","","    public func stopDictation() async throws {","        request?.endAudio()","        request = nil","        speechRecognizerTask?.cancel()","        speechRecognizerTask = nil","    }","","    public func setupAudioEngineBuffer(_ buffer: AVAudioPCMBuffer) {","        request?.append(buffer)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The standard speech recognizer uses the Speech framework to perform local, on-device recognition. It supports the following locales:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Arabic (ar-SA), Cantonese (yue-CN), Catalan (ca-ES), Chinese (zh-CN), Chinese (zh-HK), Chinese (zh-TW), Croatian (hr-HR), Czech (cs-CZ), Danish (da-DK), Dutch (nl-BE), Dutch (nl-NL), English (en-AE), English (en-AU), English (en-CA), English (en-GB), English (en-ID), English (en-IE), English (en-IN), English (en-NZ), English (en-PH), English (en-SA), English (en-SG), English (en-US), English (en-ZA), Finnish (fi-FI), French (fr-BE), French (fr-CA), French (fr-CH), French (fr-FR), German (de-AT), German (de-CH), German (de-DE), Greek (el-GR), Hebrew (he-IL), Hindi (hi-IN), Hindi (hi-IN-translit), Hindi (hi-Latn), Hungarian (hu-HU), Indonesian (id-ID), Italian (it-CH), Italian (it-IT), Japanese (ja-JP), Korean (ko-KR), Malay (ms-MY), Norwegian Bokmål (nb-NO), Polish (pl-PL), Portuguese (pt-BR), Portuguese (pt-PT), Romanian (ro-RO), Russian (ru-RU), Shanghainese (wuu-CN), Slovak (sk-SK), Spanish (es-419), Spanish (es-CL), Spanish (es-CO), Spanish (es-ES), Spanish (es-MX), Spanish (es-US), Swedish (sv-SE), Thai (th-TH), Turkish (tr-TR), Ukrainian (uk-UA), Vietnamese (vi-VN)","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can also implement the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationSpeechRecognizer"},{"text":" protocol from scratch, for instance to perform speech recognition with a custom AI model or framework that supports more languages.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Step 5. Set up your Keyboard Extension","anchor":"Step-5-Set-up-your-Keyboard-Extension","type":"heading"},{"inlineContent":[{"text":"To set up dictation for your keyboard extension, just set it up with a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp"},{"text":" with the app group and deep links from above. See the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Getting-Started-Article"},{"text":" article for more information.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardView"},{"text":" will automatically show a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationKeyboardOverlay"},{"text":" whenever dictation is active. You can customize this view or use a completely custom view if you want to show more information or controls.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Step 6. Set up your Main Application","anchor":"Step-6-Set-up-your-Main-Application","type":"heading"},{"inlineContent":[{"text":"To set up dictation for the main app, set up ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppView"},{"text":" with the same ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp"},{"text":", then apply a keyboard dictation view modifier to the main content view:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ContentView: View {","","    @Environment(\\.openURL) var openURL","    ","    @EnvironmentObject var dictationContext: DictationContext","    @EnvironmentObject var keyboardContext: KeyboardContext","","    var body: some View {","        Text(\"Insert app here :)\")","            .keyboardDictation(","                speechRecognizer: .standard \/\/ The one we just created, or a custom one.","            )","    }","}"],"type":"codeListing"},{"name":"Tip","content":[{"inlineContent":[{"type":"text","text":"If you use the "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationMethod\/app","isActive":true},{"type":"text","text":" method (deprecated), you should also present a view when the "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationContext\/dictationState","isActive":true},{"type":"text","text":" is "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationState\/active","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"style":"tip","type":"aside"},{"level":3,"text":"Step 7. Start dictation","type":"heading","anchor":"Step-7-Start-dictation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can now start dictation in your keyboard by triggering a "},{"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAction\/dictation","type":"reference","isActive":true},{"type":"text","text":" action or by calling "},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationService\/startDictationFromKeyboard()","type":"reference"},{"type":"text","text":" in the keyboard, or "},{"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationService\/startDictationInApp()","type":"reference","isActive":true},{"type":"text","text":" in the app (deprecated)."}]},{"type":"heading","anchor":"Step-8-Navigating-between-the-keyboard-and-its-main-app","text":"Step 8. Navigating between the keyboard and its main app","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"KeyboardKit will open the main application to start dictation, then return to the keyboard extension based on the "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/DictationSettings\/dictationMethod","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since the "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Host-Article","isActive":true},{"text":" capabilities were severely limited in iOS 26.4, we recommend that you show an view in your main app when the ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppContext\/openReason","isActive":true},{"text":" is ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppOpenReason\/dictation","isActive":true},{"type":"text","text":", to tell the user to tap the top-leading back arrow to return to the keyboard."}]}]}],"seeAlsoSections":[{"anchor":"Features","generated":true,"identifiers":["doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Actions","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Autocomplete","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Feedback","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Localization","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Themes"],"title":"Features"}],"abstract":[{"text":"This developer guide describes how to set up and customize dictation.","type":"text"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Articles"],["doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Features-Articles","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Dictation-Article"]]},"variants":[{"paths":["\/documentation\/keyboardkit\/developer-dictation"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/keyboardkit\/developer-dictation"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"url":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Dictation","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://com.keyboardkit.KeyboardKit/documentation/KeyboardKit/Developer-Themes":{"title":"Themes","abstract":[{"text":"This developer guide describes how to create custom keyboard themes.","type":"text"}],"type":"topic","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Themes","images":[{"identifier":"Feature-Themes.jpg","type":"card"}],"url":"\/documentation\/keyboardkit\/developer-themes","kind":"article","role":"article"},"doc://com.keyboardkit.KeyboardKit/documentation/KeyboardKit/KeyboardAppView":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"KeyboardAppView","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppView","url":"\/documentation\/keyboardkit\/keyboardappview","title":"KeyboardAppView","abstract":[{"text":"This view can be used as the root view of a keyboard app,","type":"text"},{"text":" ","type":"text"},{"text":"to set up KeyboardKit for a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp"},{"text":".","type":"text"}],"role":"symbol","navigatorTitle":[{"text