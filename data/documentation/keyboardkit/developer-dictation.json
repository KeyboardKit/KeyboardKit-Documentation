iew, to","type":"text"},{"text":" ","type":"text"},{"text":"enable dictation with a custom ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/DictationService"},{"type":"text","text":"."}],"role":"symbol","url":"\/documentation\/keyboardkit\/swiftuicore\/view\/keyboarddictation(withservice:)","title":"keyboardDictation(withService:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"keyboardDictation","kind":"identifier"},{"text":"(","kind":"text"},{"text":"withService","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"DictationService","preciseIdentifier":"s:11KeyboardKit16DictationServiceP","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}]},"https://keyboardkit.com":{"url":"https:\/\/keyboardkit.com","identifier":"https:\/\/keyboardkit.com","type":"link","titleInlineContent":[{"text":"KeyboardKit website","type":"text"}],"title":"KeyboardKit website"},"doc://src.KeyboardKit/documentation/KeyboardKit/Developer-Memory-Management":{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Developer-Memory-Management","url":"\/documentation\/keyboardkit\/developer-memory-management","type":"topic","abstract":[{"type":"text","text":"This developer guide describes how to manage memory in a keyboard extensions."}],"title":"Memory Management","role":"article","images":[{"identifier":"Developer-Article-Memory-Management.jpg","type":"card"}],"kind":"article"},"Feature-Dictation.jpg":{"identifier":"Feature-Dictation.jpg","type":"image","alt":"Feature Icon","variants":[{"url":"\/images\/src.KeyboardKit\/Feature-Dictation.jpg","traits":["1x","light"]}]},"doc://src.KeyboardKit/documentation/KeyboardKit/KeyboardServices/dictationService":{"kind":"symbol","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardK