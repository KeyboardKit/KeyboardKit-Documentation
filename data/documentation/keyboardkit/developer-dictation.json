umentation\/KeyboardKit\/KeyboardAppContext\/openReason","url":"\/documentation\/keyboardkit\/keyboardappcontext\/openreason","kind":"symbol","role":"symbol","abstract":[{"text":"A reason why the main app was opened by the keyboard,","type":"text"},{"text":" ","type":"text"},{"text":"as a raw string that allows custom reasons.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"openReason","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic"},"doc://com.keyboardkit.KeyboardKit/documentation/KeyboardKit":{"kind":"symbol","abstract":[{"text":"KeyboardKit helps you create fully customizable keyboard extensions, using Swift and SwiftUI.","type":"text"}],"type":"topic","title":"KeyboardKit","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit","url":"\/documentation\/keyboardkit","role":"collection"},"Feature-Themes.jpg":{"type":"image","alt":"Article Icon","identifier":"Feature-Themes.jpg","variants":[{"url":"\/images\/com.keyboardkit.KeyboardKit\/Feature-Themes.jpg","traits":["1x","light"]}]},"developer-dictation-url-scheme":{"variants":[{"url":"\/images\/com.keyboardkit.KeyboardKit\/developer-dictation-url-scheme.jpg","traits":["1x","light"]}],"type":"image","identifier":"developer-dictation-url-scheme","alt":"Xcode URL Scheme"},"Feature-Autocomplete.jpg":{"alt":"Article Icon","identifier":"Feature-Autocomplete.jpg","variants":[{"url":"\/images\/com.keyboardkit.KeyboardKit\/Feature-Autocomplete.jpg","traits":["1x","light"]}],"type":"image"},"doc://com.keyboardkit.KeyboardKit/documentation/KeyboardKit/DictationSpeechRecognizer":{"type":"topic","role":"symbol","navigatorTitle":[{"text":"DictationSpeechRecognizer","kind":"identifier"}],"abstract":[{"type":"text","text":"This protocol can be implemented by any type that can be"},{"type":"text","text":" "},{"type":"text","text":"used to perform sp