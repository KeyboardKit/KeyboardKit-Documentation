{"identifier":{"url":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/AI-Article","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Features-Articles"]]},"abstract":[{"type":"text","text":"This article describes the KeyboardKit AI support capabilities."}],"seeAlsoSections":[{"identifiers":["doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Actions-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/App-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Autocomplete-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Callouts-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Clipboard-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Dictation-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Emojis-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/External-Keyboards-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Feedback-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Fonts-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Host-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Layout-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Localization-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Navigation-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Plugins-Article"],"generated":true}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Apple’s native keyboard APIs lack many features that are needed when building AI-based keyboards, for instance being able to read the entire text document or letting users type text within the keyboard extension."}],"type":"paragraph"},{"style":"important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"👑 KeyboardKit Pro unlocks many AI-supporting features. You can sign up for KeyboardKit Pro from the "},{"type":"reference","identifier":"https:\/\/keyboardkit.com","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Important"},{"anchor":"Document-Reader","level":2,"type":"heading","text":"Document Reader"},{"inlineContent":[{"text":"Apple’s native ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/UIKit\/UITextDocumentProxy","isActive":true},{"text":" doesn’t return all the text within the document. It cuts off the available text at any time, e.g. at the previous or next paragraph, which makes it hard to provide AI-based features that require more context.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"KeyboardKit Pro therefore unlocks a set of "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/UIKit\/UITextDocumentProxy\/fullDocumentContext(config:)","isActive":true},{"type":"text","text":" text document proxy extensions that let you read "},{"type":"emphasis","inlineContent":[{"type":"text","text":"all"}]},{"text":" text from the current document, by moving the input cursor:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let proxy = controllerContext.textDocumentProxy","let result = try await proxy.fullDocumentContext()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This returns a "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderResult","isActive":true},{"type":"text","text":" with the "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderResult\/fullDocumentContext","isActive":true},{"type":"text","text":", as well as separate properties for the text before and after the text input cursor."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See the "