ve keyboard APIs lack many features that are needed when building AI-based keyboards, for instance being able to read the entire text document or letting users type text within the keyboard extension.","type":"text"}]},{"style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"👑 KeyboardKit Pro unlocks many AI-supporting features. You can sign up for KeyboardKit Pro from the "},{"identifier":"https:\/\/keyboardkit.com","type":"reference","isActive":true},{"type":"text","text":"."}]}],"name":"Important"},{"text":"Document Reader","type":"heading","anchor":"Document-Reader","level":2},{"type":"paragraph","inlineContent":[{"text":"Apple’s native ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/UIKit\/UITextDocumentProxy","isActive":true,"type":"reference"},{"text":" doesn’t return all the text within the document. It cuts off the available text at any time, e.g. at the previous or next paragraph, which makes it hard to provide AI-based features that require more context.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"KeyboardKit Pro therefore unlocks a set of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/UIKit\/UITextDocumentProxy\/fullDocumentContext(config:)"},{"type":"text","text":" text document proxy extensions that let you read "},{"type":"emphasis","inlineContent":[{"type":"text","text":"all"}]},{"type":"text","text":" text from the current document, by moving the input cursor:"}]},{"code":["let proxy = controllerContext.textDocumentProxy","let result = try await proxy.fullDocumentContext()"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This returns a "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderResult","isActive":true},{"type":"text","text":" with the "},{"identifier":"doc:\