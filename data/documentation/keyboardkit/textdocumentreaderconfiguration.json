":"0.02"},{"text":". You can use the","type":"text"},{"text":" ","type":"text"},{"text":"predefined ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderConfiguration\/standard","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderConfiguration\/fast","type":"reference","isActive":true},{"text":" configs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderConfiguration\/endOfProxyAttempts","type":"reference","isActive":true},{"text":" determines how many times the","type":"text"},{"text":" ","type":"text"},{"text":"proxy will attempt to move the text cursor when reaching","type":"text"},{"text":" ","type":"text"},{"text":"the beginning or the end. This is needed to handle texts","type":"text"},{"text":" ","type":"text"},{"text":"that have many line breaks, since such line breaks often","type":"text"},{"text":" ","type":"text"},{"text":"cause the proxy to stop reading any more text.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The default ","type":"text"},{"type":"codeVoice","code":"10"},{"text":" attempts will make the proxy attempt to","type":"text"},{"text":" ","type":"text"},{"text":"move the cursor that many times, to unlock more text. It","type":"text"},{"text":" ","type":"text"},{"text":"will still fail if there are more paragraphs. Using more","type":"text"},{"text":" ","type":"text"},{"text":"attempts is however taking longer to complete.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/keyboardkit\/textdocumentreaderconfiguration"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderConfiguration\/init(sleepInterval:endOfProx