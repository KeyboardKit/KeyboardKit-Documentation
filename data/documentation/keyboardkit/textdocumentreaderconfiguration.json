{"hierarchy":{"paths":[["doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit"]]},"seeAlsoSections":[{"title":"Document Reader","generated":true,"identifiers":["doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReader","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderError","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderResult"],"anchor":"Document-Reader"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextDocumentReaderConfiguration","kind":"identifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}]},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderConfiguration\/sleepInterval"},{"type":"text","text":" sets how long the reader will wait"},{"type":"text","text":" "},{"type":"text","text":"with any subsequent operations after the text cursor has"},{"type":"text","text":" "},{"type":"text","text":"been moved. This is needed since the proxy must pause to"},{"type":"text","text":" "},{"type":"text","text":"update before it can access more text. A too short delay"},{"type":"text","text":" "},{"type":"text","text":"makes the next read return no text, which will abort the"},{"type":"text","text":" "},{"type":"text","text":"operation, while a too long one makes the operation slow."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The default "},{"code":"0.04","type":"codeVoice"},{"type":"text","text":" sleep interval is tested to work well"},{"type":"text","text":" "},{"type":"text","text":"on older devices, like iPhone 7, while newer devices can"},{"type":"text","text":" "},{"type":"text","text":"use a much shorter interval like "},{"type":"codeVoice","code":"0.02"},{"type":"text","text":". You can use the"},{"type":"text","text":" "},{"type":"text","text":"predefined "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderConfiguration\/standard","isActive":true},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderConfiguration\/fast"},{"type":"text","text":" configs."}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderConfiguration\/endOfProxyAttempts","type":"reference","isActive":true},{"type":"text","text":" determines how many times the"},{"type":"text","text":" "},{"text":"proxy will attempt to move the text cursor when reaching","type":"text"},{"text":" ","type":"text"},{"text":"the beginning or the end. This is needed to handle texts","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that have many line breaks, since such line breaks often"},{"text":" ","type":"text"},{"type":"text","text":"cause the proxy to stop reading any more text."}],"type":"paragraph"},{"inlineContent":[{"text":"The default ","type":"text"},{"code":"10","type":"codeVoice"},{"text":" attempts will make the proxy attempt to","type":"text"},{"text":" ","type":"text"},{"text":"move the cursor that many times, to unlock more text. It","type":"text"},{"text":" ","type":"text"},{"text":"will still fail if there are more paragraphs. Using more","type":"text"},{"text":" ","type":"text"},{"text":"attempts is however taking longer to complete.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/keyboardkit\/textdocumentreaderconfiguration"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.keyboardk