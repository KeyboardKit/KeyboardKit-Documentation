{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderConfiguration\/sleepInterval","isActive":true},{"text":" sets how long the reader will wait","type":"text"},{"text":" ","type":"text"},{"text":"with any subsequent operations after the text cursor has","type":"text"},{"text":" ","type":"text"},{"text":"been moved. This is needed since the proxy must pause to","type":"text"},{"text":" ","type":"text"},{"text":"update before it can access more text. A too short delay","type":"text"},{"text":" ","type":"text"},{"text":"makes the next read return no text, which will abort the","type":"text"},{"text":" ","type":"text"},{"text":"operation, while a too long one makes the operation slow.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"code":"0.04","type":"codeVoice"},{"text":" sleep interval is tested to work well","type":"text"},{"text":" ","type":"text"},{"text":"on older devices, like iPhone 7, while newer devices can","type":"text"},{"text":" ","type":"text"},{"text":"use a much shorter interval like ","type":"text"},{"code":"0.02","type":"codeVoice"},{"text":". You can use the","type":"text"},{"text":" ","type":"text"},{"text":"predefined ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderConfiguration\/standard","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderConfiguration\/fast","type":"reference","isActive":true},{"text":" configs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentReaderConfiguration\/endOfProxyAttempts","isActive":true,"type":"reference"},