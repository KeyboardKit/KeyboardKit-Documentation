{"hierarchy":{"paths":[["doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Articles"],["doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Features-Articles","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Feedback-Article"]]},"metadata":{"modules":[{"name":"KeyboardKit"}],"roleHeading":"Article","color":{"standardColorIdentifier":"purple"},"role":"article","title":"Feedback","images":[{"type":"card","identifier":"Feature-Feedback.jpg"}]},"seeAlsoSections":[{"anchor":"Features","generated":true,"identifiers":["doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Actions","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Autocomplete","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Dictation","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Localization","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Themes"],"title":"Features"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Feedback"},"abstract":[{"text":"This developer guide describes how to customize keyboard feedback.","type":"text"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Audio and haptic feedback is an important part of the keyboard typing experience. See the "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Feedback-Article","isActive":true},{"type":"text","text":" article for information about the KeyboardKit  feedback feature and its many capabilities."}],"type":"paragraph"},{"level":2,"text":"How to trigger keyboard feedback","anchor":"How-to-trigger-keyboard-feedback","type":"heading"},{"inlineContent":[{"type":"text","text":"You can trigger "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAudioFeedback","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardHapticFeedback","isActive":true},{"type":"text","text":" feedback with a "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardFeedbackService","isActive":true},{"type":"text","text":" or a "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardActionHandler","isActive":true},{"type":"text","text":". The standard action handler will trigger feedback, based on the "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardFeedbackContext","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardFeedbackService\/triggerAudioFeedback(_:)","isActive":true},{"type":"text","text":" to trigger audio feedback, "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardFeedbackService\/triggerHapticFeedback(_:)","isActive":true},{"type":"text","text":" to trigger haptic feedback, and the action handler’s "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardActionHandler\/triggerFeedback(for:on:)","isActive":true},{"type":"text","text":" to trigger action-specific feedback."}],"type":"paragraph"},{"level":2,"text":"How to customize keyboard feedback","anchor":"How-to-customize-keyboard-feedback","type":"heading"},{"inlineContent":[{"type":"text","text":"You can configure the main "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardState\/feedbackContext","isActive":true},{"type":"text","text":" and its "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardFeedbackContext\/settings","isActive":true},{"type":"text","text":" to change the feedback behavior. For instance, this will customize the audio feedback for input keys, then disable haptic feedback:"}],"type":"paragraph"},{"syntax":"swift","code":["class KeyboardViewController: KeyboardInputViewController {","","    override func viewWillSetupKeyboardKit() {","        setupKeyboardKit(for: .myApp)  \/\/ See the getting-started guide","        state.feedbackContext.audioConfiguration.input = .custom(id: 1329)","        state.feedbackSettings.isHapticFeedbackEnabled = false","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can also use use the context to register custom feedback for any gesture on any action."}],"type":"paragraph"},{"syntax":"swift","code":["class KeyboardViewController: KeyboardInputViewController {","","    override func viewWillSetupKeyboardKit() {","        setupKeyboardKit(for: .myApp)  \/\/ See the getting-started guide","        let context = state.feedbackContext","        context.registerCustomFeedback(.audio(.rocketFuse, for: .press, on: .rocket))","        context.registerCustomFeedback(.audio(.rocketLaunch, for: .release, on: .rocket))","        context.registerCustomFeedback(.haptic(.selection, for: .repeat, on: .rocket))","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Since the configuration is observable, any changes will automatically cause the keyboard to update, e.g. if you have feedback toggles."}],"type":"paragraph"},{"level":2,"text":"How to define custom feedback","anchor":"How-to-define-custom-feedback","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAudioFeedback","isActive":true},{"type":"text","text":" uses "},{"type":"strong","inlineContent":[{"type":"text","text":"AudioServices"}]},{"type":"text","text":" to play system audio feedback. This means you can use any system audio (see "},{"type":"reference","identifier":"https:\/\/iphonedev.wiki\/index.php\/AudioServices","isActive":true},{"type":"text","text":") as custom audio feedback:"}],"type":"paragraph"},{"syntax":"swift","code":["extension Feedback.Audio {","","    static let sentMessage = .custom(id: 1004)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can also use the "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAudioFeedback\/customUrl(_:)","isActive":true},{"type":"text","text":" feedback type to define a custom audio feedback that loads a sound effect from an audio file:"}],"type":"paragraph"},{"syntax":"swift","code":["extension Feedback.Audio {","","    static let sentMessage = .customUrl(","        Bundle.main.url(forResource: \"sent\", withExtension: \"mp3\")","    )","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can also implement a custom action handler to trigger feedback in a different ways. See the "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Actions-Article","isActive":true},{"type":"text","text":" article for more information."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/keyboardkit\/developer-feedback"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/keyboardkit\/developer-feedback"],"traits":[{"interfaceLanguage":"occ"}]}],"kind":"article","references":{"Feature-Autocomplete.jpg":{"alt":"Article Icon","identifier":"Feature-Autocomplete.jpg","variants":[{"url":"\/imag