mics the native iOS keyboard. It supports "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Keyboard\/KeyboardType","isActive":true},{"type":"text","text":"s like "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Keyboard\/KeyboardType\/alphabetic","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Keyboard\/KeyboardType\/numeric","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Keyboard\/KeyboardType\/symbolic","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Keyboard\/KeyboardType\/emojis","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Keyboard\/KeyboardType\/numberPad","isActive":true},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Keyboard\/KeyboardType\/clipboard","isActive":true},{"type":"text","text":", as well as any "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardLayout","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Keyboard\/Placement","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Keyboard\/InputType","isActive":true},{"type":"text","text":":"}]},{"type":"row","numberOfColumns":2,"columns":[{"size":1,"content":[{"inlineContent":[{"identifier":"KeyboardView-English-Callout","type":"image"}],"type":"paragraph"}]},{"size":1,"content":[{"inlineContent":[{"identifier":"KeyboardView-Swedish-Theme","type":"image"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineCo