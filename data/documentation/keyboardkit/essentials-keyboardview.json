siest way to customize the secondary callout actions is to apply a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/SwiftUICore\/View\/keyboardCalloutActions(_:)","type":"reference"},{"text":" modifier to the view and customize the standard actions that are provided as view builder parameters.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"See the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Callouts-Article","type":"reference"},{"text":" article for more information.","type":"text"}],"type":"paragraph"}]},{"title":"Layout","content":[{"inlineContent":[{"text":"The easiest way to customize the keyboard layout is to inject a custom layout in the initializer. You can use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardLayout\/standard(for:)","type":"reference"},{"text":" to get a standard layout for the current context, then modify it as needed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"See the ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Layout-Article","isActive":true,"type":"reference"},{"text":" article for more information.","type":"text"}],"type":"paragraph"}]},{"title":"Styling","content":[{"inlineContent":[{"type":"text","text":"You can customize the styling of the "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardView","isActive":true},{"type":"text","text":" and its nested views by applying any of the many style-based view modifiers, like "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/SwiftUICore\/View\/keyboardViewStyle(_:)","isActive":true},{"text":" or ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/SwiftUICore\/View\/keyboardButtonStyle(_:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"See the "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Styling-Article","isActive":true},{"text":" article for more information.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You can customize the entire keyboard style by applying a single "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardTheme","isActive":true},{"type":"text","text":" with the "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/SwiftUICore\/View\/keyboardTheme(_:)","isActive":true},{"type":"text","text":" view modifier."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"See the ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Themes-Article","type":"reference","isActive":true},{"type":"text","text":" article for more information."}]}],"title":"Themes"},{"title":"Views","content":[{"inlineContent":[{"text":"You can customize any view or button content in the keyboard, by injecting custom view builders into the ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardView","type":"reference","isActive":true},{"type":"text","text":" initializer:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["KeyboardView(","    layout: ...,                        \/\/ You can inject a custom layout if you want to","    services: controller.services,      \/\/ You can inject a controller's or custom services","    buttonContent: { $0.view },         \/\/ You can customize the content view of any button","    buttonView: { $0.view },            \/\/ You can customize the entire view of any button","    collapsedView: { $0.view },         \/\/ You can customize the collapsed keyboard view","    emojiKeyboard: { $0.view },         \/\/ You can customize the emoji keyboard, if any","    toolbar: { params in params.view }  \/\/ You can customize the toolbar above the keyboard",")"]},{"inlineContent":[{"text":"You can return ","type":"text"},{"code":"$0.view","type":"codeVoice"},{"text":" (or ","type":"text"},{"type":"codeVoice","code":"params in params.view"},{"type":"text","text":") to use the original views, or return any custom view based on the params."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can also completely replace the "},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardView","isActive":true,"type":"reference"},{"type":"text","text":" with another view at any time. Use the "},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/SwiftUICore\/View\/keyboardReplacementOverlay(isPresented:content:)","type":"reference","isActive":true},{"type":"text","text":" extension to replace the keyboard with a custom view of the same size."}],"type":"paragraph"}]}]},{"text":"Locales","type":"heading","level":2,"anchor":"Locales"},{"inlineContent":[{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardView","type":"reference","isActive":true},{"text":" supports all ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Foundation\/Locale\/keyboardKitSupported","type":"reference","isActive":true},{"text":" locales, including regular western keyboards with different input keys, RTL keyboards, keyboards with special layouts, keyboards with special input engines, etc.","type":"text"}],"type":"paragraph"},{"type":"row","numberOfColumns":3,"columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"type":"image","identifier":"KeyboardView-English"}]}]},{"size":1,"content":[{"type":"paragraph","inlineContent":[{"identifier":"KeyboardView-Swedish","type":"image"}]}]},{"size":1,"content":[{"type":"paragraph","inlineContent":[{"identifier":"KeyboardView-Greek","type":"image"}]}]}]},{"type":"row","numberOfColum