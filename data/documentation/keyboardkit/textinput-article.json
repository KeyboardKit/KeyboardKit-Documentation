:[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController","isActive":true},{"type":"text","text":" has similar properties, but you should avoid referring to it and passing it within your code."}],"type":"paragraph"},{"level":2,"text":"Text Input Views","anchor":"Text-Input-Views","type":"heading"},{"inlineContent":[{"type":"text","text":"KeyboardKit Pro unlocks a "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardTextField","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardTextView","isActive":true},{"type":"text","text":" that let you type directly within a keyboard extension."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both views support "},{"type":"codeVoice","code":"@FocusState"},{"type":"text","text":", and have a custom "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/SwiftUICore\/View\/focused(_:doneButton:)","isActive":true},{"type":"text","text":" view modifier that lets you provide a custom done button that slides in when the view is focused, and can be tapped to end editing:"}],"type":"paragraph"},{"code":["struct CustomKeyboardToolbar: View {","","    unowned var controller: KeyboardInputViewController","","    @State ","    private var text = \"\"","","    @FocusState ","    private var isTextFieldFocused","","    var body: some View {","        if hasFullAccess {","            KeyboardTextField(","                \"Type here...\", ","                text: $text, ","                controller: controller,","                config: configureTextField,","                onSubmit: handleReturnKeyPressed    ","                \/\/ Use onSubmit: to detect the return key.","                \/\/ The onSubmit(...) view modifier 