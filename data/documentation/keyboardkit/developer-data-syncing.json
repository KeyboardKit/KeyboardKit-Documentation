{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Developer-Data-Syncing"},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/keyboardkit\/developer-data-syncing"]}],"hierarchy":{"paths":[["doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Developer-Articles"],["doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Features-Articles","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Settings-Article"]]},"sections":[],"abstract":[{"text":"This developer guide describes how to sync data between the main app and its keyboard.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"KeyboardKit makes it easy to sync data between the main app and its keyboard extension, by setting up an App Group and adding that information to your "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Step 1. Create an App Group","anchor":"Step-1-Create-an-App-Group"},{"type":"row","numberOfColumns":2,"columns":[{"size":1,"content":[{"inlineContent":[{"identifier":"developer-data-sync-developer-portal","type":"image"}],"type":"paragraph"}]},{"size":1,"content":[{"inlineContent":[{"text":"First create a new App Group in the Apple Developer Portal, under Certificates, Identifiers & Profiles.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Select Identifiers and tap the plus button to add a new App Group with the name “group.<your-apps-bundle-id>”."}],"type":"paragraph"},{"type":"aside","style":"important","content":[{"type":"paragraph"