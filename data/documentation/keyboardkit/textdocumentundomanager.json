":" ","type":"text"},{"text":"what the change expects. If not, the undo stack is reset,","type":"text"},{"text":" ","type":"text"},{"text":"instead of risking an incorrect edit.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The main ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardServices\/textDocumentUndoManager","isActive":true,"type":"reference"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"shared by ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController","isActive":true,"type":"reference"},{"text":" and the global","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardServices\/actionHandler","type":"reference"},{"text":" to let the controller","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentUndoManager\/reset()","type":"reference"},{"text":" the stack when its text changes, and let the","type":"text"},{"text":" ","type":"text"},{"text":"action handler record and undo changes.","type":"text"}]}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"This type can be used to undo text document changes that","type":"text"},{"text":" ","type":"text"},{"text":"are applied by a ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardActionHandler","type":"reference","isActive":true},{"text":", step by step.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/TextDocumentUndoChange"],"generated":true,"title":"Undo Engine","anchor":"Undo-Engine"}],"references":{"doc://src.KeyboardKit/documentation/KeyboardKit/TextDocumentUndoManager/undoLastRecordedChange(in:with:)":{"abstract":[{"text":"Undo the latest recorded change, by replaying its","type":"text"},{"text":" ","type":"t