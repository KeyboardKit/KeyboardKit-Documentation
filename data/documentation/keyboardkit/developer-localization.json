{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"This developer guide describes how to customize keyboard localization.","type":"text"}],"seeAlsoSections":[{"title":"Features","generated":true,"anchor":"Features","identifiers":["doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Actions","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Autocomplete","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Dictation","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Feedback","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Themes"]}],"metadata":{"images":[{"identifier":"Feature-Localization.jpg","type":"card"}],"role":"article","roleHeading":"Article","title":"Localization","color":{"standardColorIdentifier":"purple"},"modules":[{"name":"KeyboardKit"}]},"sections":[],"identifier":{"url":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Localization","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/keyboardkit\/developer-localization"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/keyboardkit\/developer-localization"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Developer-Articles"],["doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Features-Articles","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Localization-Article"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"KeyboardKit supports 76 locales. See the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Localization-Article","type":"reference"},{"text":" article for information about how to localize your keyboard and its various views.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"👑 KeyboardKit Pro can be used to unlock supported locales. You can sign up for KeyboardKit Pro from the ","type":"text"},{"type":"reference","identifier":"https:\/\/keyboardkit.com","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Important","style":"important"},{"level":2,"text":"How to change keyboard language","type":"heading","anchor":"How-to-change-keyboard-language"},{"inlineContent":[{"text":"You can change the keyboard language (locale) by setting the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardContext","type":"reference"},{"text":"’s ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardContext\/locale","type":"reference"},{"text":" property to any locale. Since this is an observed property, changing it will immediately update the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardView","type":"reference"},{"text":", if you use it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Setting the keyboard ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardContext\/locale","type":"reference"},{"text":" will also update the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/UIKit\/UIInputViewController","type":"reference"},{"text":"‘s ","type":"text"},{"code":"primaryLanguage","type":"codeVoice"},{"text":", which affect things like spell checking and text direction, and sets the keyboard’s language subtitle in the system keyboard switcher.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"primaryLanguage","type":"codeVoice"},{"text":" property will always return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", even after it has been set. This is confusing, but you can verify that it is set by checking that the proper language is displayed in the system keyboard switcher.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Tip","style":"tip"},{"level":2,"text":"How to support LTR & RTL locales","type":"heading","anchor":"How-to-support-LTR--RTL-locales"},{"inlineContent":[{"text":"KeyboardKit supports LTR (Left-To-Right) & RTL (Right-To-Left) locales out of the box. Just change the locale to an RTL locale like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Foundation\/Locale\/persian","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Foundation\/Locale\/arabic","type":"reference"},{"text":", and KeyboardKit will automatically adjust the text direction, spell checking, etc.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You can also force a keyboard extension to render itself in RTL. To do this, just adjust the keyboard extension’s ","type":"text"},{"inlineContent":[{"text":"Info.plist","type":"text"}],"type":"strong"},{"text":" file like this:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"inlineContent":[{"type":"text","text":"PrefersRightToLeft"}],"type":"strong"},{"type":"text","text":" to "},{"inlineContent":[{"type":"text","text":"1"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"inlineContent":[{"type":"text","text":"PrimaryLanguage"}],"type":"strong"},{"type":"text","text":" to the language code of your locale, e.g. "},{"inlineContent":[{"type":"text","text":"fa"}],"type":"strong"},{"type":"text","text":" for Perian (Farsi)."}]}]}]},{"inlineContent":[{"text":"Just be aware that setting the primary language like this may affect external keyboard mappings if you don’t set the primary language.","type":"text"}],"type":"paragraph"},{"level":2,"text":"How to translate localized content","type":"heading","anchor":"How-to-translate-localized-content"},{"inlineContent":[{"text":"Each ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Foundation\/Locale\/keyboardKitSupported","type":"reference"},{"text":" locale has a localized file in ","type":"text"},{"inlineContent":[{"text":"Resources\/[id].lproj","type":"text"}],"type":"strong"},{"text":" with texts that are applied with the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KKL10n","type":"reference"},{"text":" enum:","type":"text"}],"type":"paragraph"},{"code":["let translation = KKL10n.keyboardTypeNumeric.text"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"You can translate any key for any supported locale, using the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KKL10n\/text(forLocale:)","type":"reference"},{"text":", which parses the resource for the provided locale.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"The native keyboard doesn’t use as many localized strings in iOS 26 as in previous system versions. KeyboardKit still keeps all the localized strings for backwards compatibility.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Note","style":"note"},{"level":2,"text":"How to translate locale display names","type":"heading","anchor":"How-to-translate-locale-display-names"},{"inlineContent":[{"text":"You can change the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardContext","type":"reference"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardContext\/localePresentationLocale","type":"reference"},{"text":" to set which locale to use when displaying locales. It’s set to the current locale by default, but you can change it to any locale, or set it to nil to use each locale’s own language.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"KeyboardKit also extends ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Foundation\/Locale","type":"reference"},{"text":" with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Foundation\/Locale\/localizedName","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Foundation\/Locale\/localizedName(in:)","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Foundation\/Locale\/localizedLanguageName(in:)","type":"reference"},{"text":" to let you display a locale in any way you like.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://com.keyboardkit.KeyboardKit/documentation/KeyboardKit/KeyboardContext":{"role":"symbol","abstract":[{"type":"text","text":"This class has observable states and persistent settings"},{"type":"text","text":" "},{"type":"text","text":"for the core keyboard functionality."}],"title":"KeyboardContext","navigatorTitle":[{"text":"KeyboardContext","kind":"identifier"}],"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardContext","url":"\/documentation\/keyboardkit\/keyboardcontext","type":"topic","kind":"symbol"