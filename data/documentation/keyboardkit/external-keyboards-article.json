{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/External-Keyboards-Article"},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/keyboardkit\/external-keyboards-article"]}],"hierarchy":{"paths":[["doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Features-Articles"]]},"sections":[],"abstract":[{"text":"This article describes the KeyboardKit external keyboard engine.","type":"text"}],"topicSections":[{"title":"Types","anchor":"Types","identifiers":["doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/ExternalKeyboardContext"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"Keyboard extensions start to behave strangely when you type on an external keyboard. For instance, the keyboard extension will stop receiving information about when the text changes, and will only update the context when the text cursor moves."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Due to this, KeyboardKit makes it possible to collapse the keyboard when a hardware keyboard is connected, to avoid a bad experience."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"👑 KeyboardKit Pro unlocks ways to detect if an external keyboard is connected, which can automatically collapse the keyboard.","type":"text"}]}],"style":"tip","type":"aside","name":"Tip"},{"type":"heading","level":2,"anchor":"Context","text":"Context"},{"type":"paragraph","inlineContent":[{"type":"text","text":"KeyboardKit has an "},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/ExternalKeyboardContext","type":"reference","isActive":true},{"text":" class with observable state, that is automatically updated if an external keyboard is connected or d