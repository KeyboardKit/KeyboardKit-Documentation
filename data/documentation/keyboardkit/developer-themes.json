t","text":" engine makes it easy to style an entire keyboard with a single theme. KeyboardKit Pro has many "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardTheme\/predefined"},{"type":"text","text":" themes, and lets you create completely custom themes as well."}],"type":"paragraph"},{"style":"important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"👑 KeyboardKit Pro unlocks a theme engine for all licenses that include the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/ProFeature\/themes"},{"type":"text","text":" feature. You can sign up for KeyboardKit Pro from the "},{"isActive":true,"type":"reference","identifier":"https:\/\/keyboardkit.com"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Important"},{"text":"How to create a custom theme","anchor":"How-to-create-a-custom-theme","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Since a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardTheme"},{"type":"text","text":" is just a struct, you can easily create your own custom themes by just defining new static theme value types."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For instance, this theme only changes the color of the primary button:"}],"type":"paragraph"},{"code":["extension KeyboardTheme {","","    static var greenPrimary: Self {","        get throws {","            try? Self(primaryBackgroundColor: .green)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"You can also use other themes as a baseline when creating a custom theme, if you only want to change some parts of another theme:"}],"type":"paragraph"},{"code":["extension KeyboardTheme {","","    static var pinkPrimary: Self {","        get throws {","          