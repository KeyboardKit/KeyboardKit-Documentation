KitHostPlugin"},{"type":"text","text":". See each feature article for more information about how to use each plugin."}]},{"type":"heading","anchor":"Step-2-Define-app-specific-information","level":2,"text":"Step 2. Define app-specific information"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The easiest way to set up KeyboardKit is with a "},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp","isActive":true,"type":"reference"},{"type":"text","text":" that can define a "},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/licenseKey","isActive":true,"type":"reference"},{"type":"text","text":", an "},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/appGroupId","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/deepLinks-swift.property","isActive":true,"type":"reference"},{"type":"text","text":", etc."}]},{"code":["import KeyboardKit","","extension KeyboardApp {","","    static var myApp: KeyboardApp {","        .init(","            name: \"My App\",","            licenseKey: \"your-license-key\",             \/\/ Unlocks KeyboardKit Pro","            appGroupId: \"group.com.myapp\",              \/\/ Sets up App Group data sync","            locales: .keyboardKitSupported,             \/\/ Sets up the enabled locales","            deepLinks: .init(app: \"myapp:\/\/\", ...)      \/\/ Defines how to open the app","            autocomplete: .init(                        \/\/ Sets up autocomplete addons  ","                nextWordPredictionRequest: .claude(...) \/\/ Sets up AI-based prediction","            ),","            gifProvider: .giphy(apiKey: \"...\"),         \/\/ Defines a GIF provider","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Define this in a file that you add to your app ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"text":" keyboard extension, to be able to use it in both targets. See ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/App-Article","isActive":true,"type":"reference"},{"text":" for more info.","type":"text"}]},{"text":"Step 3. Set up the keyboard extension","anchor":"Step-3-Set-up-the-keyboard-extension","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To set up your keyboard extension, inherit "},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController"},{"text":" instead of the default UIInputViewController, override ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/viewWillSetupKeyboardKit()"},{"text":" and call ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/setupKeyboardKit(for:completion:)"},{"text":" with your ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"code":["import KeyboardKit","","class KeyboardController: KeyboardInputViewController {","","    override func viewWillSetupKeyboardKit() {","        super.viewWillSetupKeyboardKit()","        setupKeyboardKit(for: .myApp) { result in","            \/\/ If the result is `.success`, the setup succeeded.","            \/\/ This is where you can set up custom services and","            \/\/ start using KeyboardKit Pro-based features. ","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This will extend your controller with more capabilities, new lifecycle functions, keyboard "},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/services","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/state","type":"reference","isActive":true},{"type":"text","text":", etc. It will also unlock KeyboardKit Pro if your "},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp","type":"reference","isActive":true},{"text":" defines a ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/licenseKey","type":"reference","isActive":true},{"text":", or if you have added a license file to your app bundle.","type":"text"}]},{"inlineContent":[{"text":"Setting up KeyboardKit will enable ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Developer-Data-Syncing","isActive":true,"type":"reference"},{"type":"text","text":" between the app and its keyboard (if the app defines an "},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/appGroupId","isActive":true,"type":"reference"},{"type":"text","text":"), register "},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/deepLinks-swift.property","isActive":true,"type":"reference"},{"type":"text","text":", enable "},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Dictation-Article","isActive":true,"type":"reference"},{"type":"text","text":", etc. You can also setup plugins with a setupKeyboardKit variant that has more arguments."}],"type":"paragraph"},{"style":"tip","type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/setupKeyboardKit(for:completion:)","isActive":true,"type":"reference"},{"type":"text","text":" has a variant that can inject plugins. See the "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Plugins-Article","isActive":true},{"type":"text","text":" article for more information."}]}]},{"type":"heading","text":"Step 4. Set up a custom keyboard view (optional)","level":2,"anchor":"Step-4-Set-up-a-custom-keyboard-view-optional"},{"inlineContent":[{"text":"To replace or customize the ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardView","isActive":true},{"text":", override ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/viewWillSetupKeyboardView()","isActive":true},{"text":" and call ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/setupKeyboardView(_:)","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["class KeyboardViewController: KeyboardInputViewController {","","    override func viewWillSetupKeyboardView() {","        \/\/ super.viewWillSetupKeyboardView()           \/\/ Don't call super! It causes extra draw ops. ","        setupKeyboardView { [weak self] controller in  \/\/ Use weak or unknowned if you must use self!","            CustomKeyboardView(","                services: controller.services","            )","        }","    }","}","","\/\/ Define custom views in separate types to keep your controller clean.","struct CustomKeyboardView: View {","","    var services: KeyboardServices","","    @EnvironmentObject private var keyboardContext: KeyboardContext","    @EnvironmentObject private var keyboardSettings: KeyboardSettings","","    var body: some View {","        if keyboardContext.keyboardType == .images {","            MyCustomGifKeyboard()","        } else {","            KeyboardView(","                services: services,","                buttonContent: { $0.view },        \/\/ Use $0.view to use the standard view","                buttonView: { $0.view },           \/\/ The $0 arg has additional properties             ","                collapsedView: { params in params.view },   \/\/ This is the same as $0.view","                emojiKeyboard: { $0.view },        ","                toolbar: { _ in CustomToolbar() }  \/\/ You can customize any view like this","            )","        }","    }","}"]},{"name":"Important","type":"aside","style":"important","content":[{"inlineContent":[{"text":"Passing ","type":"text"},{"code":"self","type":"codeVoice"},{"text":" into the keyboard view will result in a memory leak if you forget ","type":"text"},{"code":"[weak self]","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"[unowned self]","type":"codeVoice"},{"text":". The ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/setupKeyboardView(_:)","isActive":true,"type":"reference"},{"text":" builder provides an unowned controller reference that you can use to avoid memory leaks.","type":"text"}],"type":"paragraph"}]},{"type":"heading","level":2,"text":"Step 5. Set up the main app (optional)","anchor":"Step-5-Set-up-the-main-app-optional"},{"type":"paragraph","inlineContent":[{"text":"The main app can be used to handle the keyboard status, link to System Settings, etc. It’s also a great place for ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardSettings","isActive":true,"type":"reference"},{"text":", since it has more space than the keyboard extension.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The easiest way to set up the main app is to use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppView","type":"reference"},{"text":" as the root view, with the same ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp","type":"reference"},{"type":"text","text":" as the keyboard:"}]},{"syntax":"swift","type":"codeListing","code":["@main","struct MyApp: App {","","    var body: some Scene {","        WindowGroup {","            KeyboardAppView(for: .myApp) {","                ContentView() \/\/ <-- Your specific app root","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This will set up the main app the same way as the keyboard extension, register KeyboardKit Pro before rendering the content view, etc."}]},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/App-Article"},{"text":" for more information about how to easily set up a full-blown keyboard app with KeyboardKit Pro’s various app utilities.","type":"text"}]},{"anchor":"Step-6-Customize-state--services-optional","text":"Step 6. Customize state & services (optional)","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController","isActive":true},{"type":"text","text":" has keyboard-related "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/state","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/services","isActive":true},{"type":"text","text":". All state values are observed and will redraw the keyboard when changed. For instance, changing the "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardContext\/keyboardType","isActive":true},{"type":"text","text":" will automatically redraw the keyboard."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"KeyboardKit will inject all observable ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/state","type":"reference","isActive":true},{"type":"text","text":" values into the environment. This means that you can access them from any view, like this:"}]},{"syntax":"swift","code":["struct CustomView: View {","","    @EnvironmentObject var keyboardContext: KeyboardContext","    @EnvironmentObject var keyboardSettings: KeyboardSettings","    ","    var body: some View {","        ...","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"You can replace any services with custom implementations. For instance, here we replace the standard "},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardActionHandler","isActive":true},{"type":"text","text":" that customizes the standard action handler:"}],"type":"paragraph"},{"syntax":"swift","code":["class KeyboardViewController: KeyboardInputViewController {","","    override func viewWillSetupKeyboardKit() {","        services.actionHandler = CustomActionHandler(controller: self)","        setupKeyboardKit(for: .myApp) { ... }","    }","}","","class CustomActionHandler: StandardKeyboardActionHandler {","","    open override func handle(_ action: KeyboardAction) {","        if action == .space {","            print(\"Pressed space!\")","        }","        super.handle(action) ","    }","}"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"All customizations that rely on Pro features must be made in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/setupKeyboardKit(for:completion:)","type":"reference"},{"text":" completion block.","type":"text"}]}],"name":"Important","type":"aside","style":"important"},{"level":2,"text":"Bonus - Setting up KeyboardKit as a package dependency","type":"heading","anchor":"Bonus-Setting-up-KeyboardKit-as-a-package-dependency"},{"type":"paragraph","inlineContent":[{"text":"To set up KeyboardKit as a package dependency, just add it to your package’s ","type":"text"},{"type":"codeVoice","code":"dependencies"},{"text":" list and link it to all targets that need it.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["...","dependencies: [","    .package(","        url: \"https:\/\/github.com\/KeyboardKit\/KeyboardKit.git\",","        .upToNextMajor(from: \"11.0.0\")","    )","],","targets: [","    .target(","        name: \"MyPackage\",","        dependencies: [\"KeyboardKit\"]","    )","]"]},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Since KeyboardKit is a binary package, you don’t have to link it to targets that use ","type":"text"},{"inlineContent":[{"text":"your","type":"text"}],"type":"emphasis"},{"text":" package, but a target ","type":"text"},{"inlineContent":[{"text":"must","type":"text"}],"type":"emphasis"},{"text":" update ","type":"text"},{"inlineContent":[{"type":"text","text":"runpath search paths"}],"type":"strong"},{"text":" under its Build Settings. Use ","type":"text"},{"inlineContent":[{"text":"@executable_path\/Frameworks","type":"text"}],"type":"strong"},{"text":" for apps and ","type":"text"},{"inlineContent":[{"text":"@executable_path\/..\/..\/Frameworks","type":"text"}],"type":"strong"},{"text":" for keyboards. Failing to set the search paths will cause a runtime crash.","type":"text"}]}],"type":"aside","name":"Important"},{"anchor":"Thats-it","text":"That’s it!","type":"heading","level":2},{"inlineContent":[{"text":"You should now have a functional keyboard extension and main app that you can customize further to fit your needs. See the ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Essentials-Article","isActive":true,"type":"reference"},{"text":" article for further information, as well as the other feature and developer articles.","type":"text"}],"type":"p