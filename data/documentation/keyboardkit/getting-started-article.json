{"abstract":[{"text":"This getting-started guide helps you get started with KeyboardKit.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"article","title":"Getting Started","modules":[{"name":"KeyboardKit"}],"roleHeading":"Article"},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit"]]},"identifier":{"url":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Getting-Started-Article","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"anchor":"Articles","title":"Articles","identifiers":["doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Essentials-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Essentials-KeyboardView","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Accessibility-Article","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Features-Articles","doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Developer-Articles"]}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"This getting-started guide shows how to install KeyboardKit and set it up for the both main app and its keyboard extension, and how to use it as a package dependency for more advanced integrations.","type":"text"}]},{"text":"Step 1. Install KeyboardKit","type":"heading","level":2,"anchor":"Step-1-Install-KeyboardKit"},{"type":"paragraph","inlineContent":[{"text":"KeyboardKit can be installed with the Swift Package Manager:","type":"text"}]},{"syntax":null,"code":["https:\/\/github.com\/KeyboardKit\/KeyboardKit.git"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"KeyboardKit is a binary target and must ONLY be added to the app target. If you add it to any other target, it may crash at runtime.","type":"text"}]}],"type":"aside","style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"text":"When installing KeyboardKit, you get the option to install additional plugins, like ","type":"text"},{"type":"codeVoice","code":"KeyboardKitDictationPlugin"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"KeyboardKitHostPlugin"},{"text":". See each feature article for more information about how to use each plugin.","type":"text"}]},{"text":"Step 2. Define app-specific information","type":"heading","level":2,"anchor":"Step-2-Define-app-specific-information"},{"type":"paragraph","inlineContent":[{"text":"The easiest way to set up KeyboardKit is with a ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp","isActive":true},{"text":" that can define a ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/licenseKey","isActive":true},{"text":", an ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/appGroupId","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/deepLinks-swift.property","isActive":true},{"text":", etc.","type":"text"}]},{"syntax":"swift","code":["import KeyboardKit","","extension KeyboardApp {","","    static var myApp: KeyboardApp {","        .init(","            name: \"My App\",","            licenseKey: \"your-license-key\",             \/\/ Unlocks KeyboardKit Pro","            appGroupId: \"group.com.myapp\",              \/\/ Sets up App Group data sync","            locales: .keyboardKitSupported,             \/\/ Sets up the enabled locales","            autocomplete: .init(                        \/\/ Sets up autocomplete addons  ","                nextWordPredictionRequest: .claude(...) \/\/ Sets up AI-based prediction","            ),","            deepLinks: .init(app: \"myapp:\/\/\", ...)      \/\/ Defines how to open the app","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Define this in a file that you add to your app ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"text":" keyboard extension, to be able to use it in both targets. See ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/App-Article","type":"reference","isActive":true},{"text":" for more info.","type":"text"}],"type":"paragraph"},{"text":"Step 3. Set up the keyboard extension","type":"heading","level":2,"anchor":"Step-3-Set-up-the-keyboard-extension"},{"type":"paragraph","inlineContent":[{"text":"To set up your keyboard extension, inherit ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController","type":"reference","isActive":true},{"text":" instead of the default UIInputViewController, override ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/viewWillSetupKeyboardKit()","type":"reference","isActive":true},{"text":" and call ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/setupKeyboardKit(for:completion:)","type":"reference","isActive":true},{"text":" with your ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp","type":"reference","isActive":true},{"text":":","type":"text"}]},{"code":["import KeyboardKit","","class KeyboardController: KeyboardInputViewController {","","    override func viewWillSetupKeyboardKit() {","        super.viewWillSetupKeyboardKit()","        setupKeyboardKit(for: .myApp) { result in","            \/\/ If the result is `.success`, the setup succeeded.","            \/\/ This is where you can set up custom services and","            \/\/ start using KeyboardKit Pro-based features. ","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"This will extend your controller with more capabilities, new lifecycle functions, keyboard ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/services","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/state","isActive":true},{"text":", etc. It will also unlock KeyboardKit Pro if your ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp","isActive":true},{"text":" defines a ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/licenseKey","type":"reference","isActive":true},{"text":", or if you have added a license file to your app bundle.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Setting up KeyboardKit will enable ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Developer-Data-Syncing","isActive":true},{"text":" between the app and its keyboard (if the app defines an ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/appGroupId","isActive":true},{"text":"), register ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/deepLinks-swift.property","isActive":true},{"text":", enable ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Dictation-Article","isActive":true},{"text":", etc. You can also setup plugins with a setupKeyboardKit variant that has more arguments.","type":"text"}]},{"type":"aside","style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/setupKeyboardKit(for:completion:)","isActive":true,"type":"reference"},{"text":" has a variant that can inject plugins. See the ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Plugins-Article","isActive":true,"type":"reference"},{"text":" article for more information.","type":"text"}]}]},{"level":2,"text":"Step 4. Set up a custom keyboard view (optional)","anchor":"Step-4-Set-up-a-custom-keyboard-view-optional","type":"heading"},{"inlineContent":[{"text":"To replace or customize the ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardView","isActive":true,"type":"reference"},{"text":", override ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/viewWillSetupKeyboardView()","isActive":true,"type":"reference"},{"text":" and call ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/setupKeyboardView(_:)","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["class KeyboardViewController: KeyboardInputViewController {","","    override func viewWillSetupKeyboardView() {","        \/\/ super.viewWillSetupKeyboardView()           \/\/ Don't call super! It causes extra draw ops. ","        setupKeyboardView { [weak self] controller in  \/\/ Use weak or unknowned if you must use self!","            CustomKeyboardView(","                services: controller.services","            )","        }","    }","}","","\/\/ Define custom views in separate types to keep your controller clean.","struct CustomKeyboardView: View {","","    var services: KeyboardServices","","    @EnvironmentObject private var keyboardContext: KeyboardContext","    @EnvironmentObject private var keyboardSettings: KeyboardSettings","","    var body: some View {","        if keyboardContext.keyboardType == .images {","            MyCustomGifKeyboard()","        } else {","            KeyboardView(","                services: services,","                buttonContent: { $0.view },        \/\/ Use $0.view to use the standard view","                buttonView: { $0.view },           \/\/ The $0 arg has additional properties             ","                collapsedView: { params in params.view },   \/\/ This is the same as $0.view","                emojiKeyboard: { $0.view },        ","                toolbar: { _ in CustomToolbar() }  \/\/ You can customize any view like this","            )","        }","    }","}"]},{"name":"Important","type":"aside","style":"important","content":[{"inlineContent":[{"text":"Passing ","type":"text"},{"type":"codeVoice","code":"self"},{"text":" into the keyboard view will result in a memory leak if you forget ","type":"text"},{"type":"codeVoice","code":"[weak self]"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"[unowned self]"},{"text":". The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/setupKeyboardView(_:)","type":"reference"},{"text":" builder provides an unowned controller reference that you can use to avoid memory leaks.","type":"text"}],"type":"paragraph"}]},{"text":"Step 5. Set up the main app (optional)","level":2,"type":"heading","anchor":"Step-5-Set-up-the-main-app-optional"},{"type":"paragraph","inlineContent":[{"text":"The main app can be used to handle the keyboard status, link to System Settings, etc. It’s also a great place for ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardSettings","type":"reference","isActive":true},{"text":", since it has more space than the keyboard extension.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The easiest way to set up the main app is to use ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppView","isActive":true,"type":"reference"},{"text":" as the root view, with the same ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp","isActive":true,"type":"reference"},{"text":" as the keyboard:","type":"text"}]},{"code":["@main","struct MyApp: App {","","    var body: some Scene {","        WindowGroup {","            KeyboardAppView(for: .myApp) {","                ContentView() \/\/ <-- Your specific app root","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"This will set up the main app the same way as the keyboard extension, register KeyboardKit Pro before rendering the content view, etc.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/App-Article","isActive":true,"type":"reference"},{"text":" for more information about how to easily set up a full-blown keyboard app with KeyboardKit Pro’s various app utilities.","type":"text"}]},{"text":"Step 6. Customize state & services (optional)","anchor":"Step-6-Customize-state--services-optional","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController","type":"reference"},{"text":" has keyboard-related ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/state","type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/services","isActive":true,"type":"reference"},{"text":". All state values are observed and will redraw the keyboard when changed. For instance, changing the ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardContext\/keyboardType","isActive":true,"type":"reference"},{"text":" will automatically redraw the keyboard.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"KeyboardKit will inject all observable ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/state","isActive":true},{"text":" values into the environment. This means that you can access them from any view, like this:","type":"text"}]},{"syntax":"swift","code":["struct CustomView: View {","","    @EnvironmentObject var keyboardContext: KeyboardContext","    @EnvironmentObject var keyboardSettings: KeyboardSettings","    ","    var body: some View {","        ...","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"You can replace any services with custom implementations. For instance, here we replace the standard ","type":"text"},{"type":"reference","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardActionHandler","isActive":true},{"text":" that customizes the standard action handler:","type":"text"}]},{"syntax":"swift","code":["class KeyboardViewController: KeyboardInputViewController {","","    override func viewWillSetupKeyboardKit() {","        services.actionHandler = CustomActionHandler(controller: self)","        setupKeyboardKit(for: .myApp) { ... }","    }","}","","class CustomActionHandler: StandardKeyboardActionHandler {","","    open override func handle(_ action: KeyboardAction) {","        if action == .space {","            print(\"Pressed space!\")","        }","        super.handle(action) ","    }","}"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"All customizations that rely on Pro features must be made in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/setupKeyboardKit(for:completion:)","type":"reference"},{"text":" completion block.","type":"text"}]}],"type":"aside","style":"important","name":"Important"},{"text":"Bonus - Setting up KeyboardKit as a package dependency","level":2,"type":"heading","anchor":"Bonus-Setting-up-KeyboardKit-as-a-package-dependency"},{"inlineContent":[{"text":"To set up KeyboardKit as a package dependency, just add it to your package’s ","type":"text"},{"code":"dependencies","type":"codeVoice"},{"text":" list and link it to all targets that need it.","type":"text"}],"type":"paragraph"},{"code":["...","dependencies: [","    .package(","        url: \"https:\/\/github.com\/KeyboardKit\/KeyboardKit.git\",","        .upToNextMajor(from: \"11.0.0\")","    )","],","targets: [","    .target(","        name: \"MyPackage\",","        dependencies: [\"KeyboardKit\"]","    )","]"],"syntax":"swift","type":"codeListing"},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Since KeyboardKit is a binary package, you don’t have to link it to targets that use ","type":"text"},{"inlineContent":[{"text":"your","type":"text"}],"type":"emphasis"},{"text":" package, but a target ","type":"text"},{"inlineContent":[{"text":"must","type":"text"}],"type":"emphasis"},{"text":" update ","type":"text"},{"type":"strong","inlineContent":[{"text":"runpath search paths","type":"text"}]},{"text":" under its Build Settings. Use ","type":"text"},{"type":"strong","inlineContent":[{"text":"@executable_path\/Frameworks","type":"text"}]},{"text":" for apps and ","type":"text"},{"type":"strong","inlineContent":[{"text":"@executable_path\/..\/..\/Frameworks","type":"text"}]},{"text":" for keyboards. Failing to set the search paths will cause a runtime crash.","type":"text"}]}],"style":"important"},{"text":"That’s it!","anchor":"Thats-it","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"You should now have a functional keyboard extension and main app that you can customize further to fit your needs. See the ","type":"text"},{"identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Essentials-Article","isActive":true,"type":"reference"},{"text":" article for further information, as well as the other feature and developer articles.","type":"text"}]},{"type":"thematicBreak"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/keyboardkit\/getting-started-article"]}],"references":{"Feature-Dictation.jpg":{"identifier":"Feature-Dictation.jpg","variants":[{"traits":["1x","light"],"url":"\/images\/src.KeyboardKit\/Feature-Dictation.jpg"}],"type":"image","alt":"Feature Icon"},"doc://src.KeyboardKit/documentation/KeyboardKit/Developer-Articles":{"abstract":[{"text":"This article links to various developer guides, include feature customiation guides.","type":"text"}],"title":"Developer Guides","kind":"article","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/Developer-Articles","type":"topic","url":"\/documentation\/keyboardkit\/developer-articles","role":"collectionGroup"},"doc://src.KeyboardKit/documentation/KeyboardKit/KeyboardView":{"abstract":[{"type":"text","text":"This view renders a view that mimics the native keyboard."}],"title":"KeyboardView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyboardView","kind":"identifier"}],"navigatorTitle":[{"text":"KeyboardView","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/src.KeyboardKit\/documentation\/KeyboardKit\/KeyboardView","type":"topic","url":"\/documentation\/keyboardkit\/keyboardview","role":"symbol"},"doc://src.KeyboardKit/documentation/KeyboardKit/KeyboardApp":{"abstract":[{"text":"This type can be used to define important properties for","type":"text"},{"text":" ","type":"text"},{"text":"your app, and is also a namespace for app-based features.","type":"text"}],"title":"KeyboardApp","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyboardApp","kind":"identifier"}],"navigatorTitle":[{"text":"KeyboardApp","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/src.KeyboardKi