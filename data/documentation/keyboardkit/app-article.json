{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/App-Article"},"abstract":[{"type":"text","text":"This article describes the KeyboardKit app-specific utilities."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/keyboardkit\/app-article"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/keyboardkit\/app-article"]}],"topicSections":[{"identifiers":["doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppContext","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppOpenReason","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppSettings"],"title":"Types","anchor":"Types"},{"identifiers":["doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppHomeScreen","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppHomeScreenLocalization","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppHomeScreenStyle","doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppHomeScreenVisibility"],"title":"Screens","anchor":"Screens"},{"identifiers":["doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppView"],"title":"Views","anchor":"Views"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"KeyboardKit has app-specific utilities to help you build a great main app for your keyboard, sync data between the app & keyboard, etc."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp","isActive":true},{"type":"text","text":" struct can be used to set up both your keyboard and main app, while the "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppView","isActive":true},{"type":"text","text":" can be used to set up the main app and render the content view once your KeyboardKit Pro license is validated."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In the main app, the "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppHomeScreen","isActive":true},{"type":"text","text":" lets you set up a complete keyboard app home screen with just a few lines of code."}]},{"type":"heading","level":2,"text":"App Information","anchor":"App-Information"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp","isActive":true},{"type":"text","text":" struct can be used to describe your app and its configuration, such as "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/name","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/deepLinks-swift.property","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/appGroupId","isActive":true},{"type":"text","text":", etc."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can create an app-specific "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp","isActive":true},{"type":"text","text":" value to set up your app and keyboard. See the "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Getting-Started-Article","isActive":true},{"type":"text","text":" guide for more details."}]},{"type":"heading","level":2,"text":"Context","anchor":"Context"},{"type":"paragraph","inlineContent":[{"type":"text","text":"KeyboardKit has a "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppContext","isActive":true},{"type":"text","text":" class with observable state and auto-persisted app "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppContext\/settings","isActive":true},{"type":"text","text":". It has values like "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppContext\/openReason","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppContext\/openReasonCase","isActive":true},{"type":"text","text":", to let you know why the main app was opened by the keyboard."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Since Apple restricts keyboards from knowing about their host app, and restricts the main app from returning to the keyboard, you can use the "},{"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppContext\/openReason","isActive":true,"type":"reference"},{"type":"text","text":" to determine if you should present a message to show the user how to tap the top leading back button to return to the keyboard. For instance, opening the main app from the keyboard to start the dictation engine will set the reason to "},{"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppOpenReason\/dictation","isActive":true,"type":"reference"},{"type":"text","text":".  The reason will auto-reset when the main app is sent to the background."}]}],"type":"aside","style":"tip","name":"Tip"},{"type":"paragraph","inlineContent":[{"type":"text","text":"KeyboardKit automatically creates an instance of this class and registers it with its "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardInputViewController\/state","isActive":true},{"type":"text","text":", and also injects it into the view environment."}]},{"type":"heading","level":2,"text":"Settings","anchor":"Settings"},{"type":"paragraph","inlineContent":[{"type":"text","text":"KeyboardKit has a "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppSettings","isActive":true},{"type":"text","text":" type with auto-persisted settings. This is currently only used for internal persistency, but may be extended in the future. The context "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppContext\/settings","isActive":true},{"type":"text","text":" is used by default."}]},{"type":"heading","level":2,"text":"Screens","anchor":"Screens"},{"type":"paragraph","inlineContent":[{"type":"text","text":"KeyboardKit Pro unlocks a "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppHomeScreen","isActive":true},{"type":"text","text":" that let you quickly add keyboard-related features to your main app target."}]},{"numberOfColumns":2,"type":"row","columns":[{"size":1,"content":[{"type":"paragraph","inlineContent":[{"identifier":"KeyboardAppHomeScreen","type":"image"}]}]},{"size":1,"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardApp\/HomeScreen","isActive":true,"type":"reference"},{"text":" can be used as the main screen of a keyboard app, to quickly get your main app up and running.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The screen shows an app icon, a keyboard status section, links to other settings screens, custom header and footer views, etc.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This screen can be customized with the following view modifiers:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/SwiftUICore\/View\/keyboardAppHomeScreenLocalization(_:)","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/SwiftUICore\/View\/keyboardAppHomeScreenStyle(_:)","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/SwiftUICore\/View\/keyboardAppHomeScreenVisibility(_:)","isActive":true,"type":"reference"}]}]}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The screen has view modifiers to let you toggle the visibility of certain parts of the screen, and style and localize them to fit your needs:"}]},{"type":"codeListing","code":["NavigationStack {","    KeyboardApp.HomeScreen(","        app: .myApp,","        appIcon: Image(.icon),","        header: {},","        footer: textFieldSection","    )","    .navigationTitle(\"KeyboardKit\")","}",".keyboardAppHomeScreenLocalization(","    .init(keyboardSectionFooter: \"Here's a custom footer text.\")",")",".keyboardAppHomeScreenStyle(","    .init(appIconSize: 150)",")",".keyboardAppHomeScreenVisibility(","    .init(keyboardSection: true)",")"],"syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You must use an App Group for settings to sync between your app and its keyboard. See the "},{"identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Settings-Article","isActive":true,"type":"reference"},{"type":"text","text":" article for more information."}]}],"type":"aside","style":"important","name":"Important"},{"type":"heading","level":2,"text":"Views","anchor":"Views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppView","isActive":true},{"type":"text","text":" should be used as the root view of your main app. It will set up the app, make "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Foundation\/UserDefaults\/keyboardSettings","isActive":true},{"type":"text","text":" sync data between the app and keyboard, set up KeyboardKit Pro, etc. See "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/Getting-Started-Article","isActive":true},{"type":"text","text":" for more information."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The  "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardAppView","isActive":true},{"type":"text","text":" will also inject observable "},{"type":"reference","identifier":"doc:\/\/com.keyboardkit.KeyboardKit\/documentation\/KeyboardKit\/KeyboardState","isActive":true},{"type":"text","text":" types into the environment, to let you access them like this:"}]},{"type":"codeListing","code":["@main","struct MyApp: App {","","    var body: some Scene {","        WindowGroup {","            KeyboardAppView(for: .myApp) {","                ContentView() \/\/ <-- Your specific app root view","            }","        }","    }","}","","struct ContentView: View {","","    @EnvironmentObject var keyboardContext: KeyboardContext","","    var body: View {","        YourMainContentView()","            .keyboardDictation(...) \/\/ <-- Keyboard-specific modifiers go here ","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Unlike the "},{"type":"refere